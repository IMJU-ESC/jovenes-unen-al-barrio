rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() {
      return request.auth != null && (request.auth.uid == '36jBRapT5IOKncMJals27tiB0k32'
        || (request.auth.uid == 'mbagg6lUNZOMC2ql6CKX0tUyGTX2' && request.auth.token.email_verified == true && request.auth.token.email == 'imjuesc@gmail.com'));
    }
    function account() {
      return get(/databases/$(database)/documents/accesos/$(request.auth.uid)).data;
    }
    function active() {
      return request.auth != null && account().activo && account().listo;
    }
    function own(id) {
      return active() && account().participante == id;
    }
    match /accesos/{uid} {
      allow get: if admin() || (request.auth != null && request.auth.uid == uid);
      allow list, create, delete: if admin();
      allow update: if admin() || (request.auth != null && request.auth.uid == uid
        && resource.data.activo && !resource.data.listo && request.resource.data.listo == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['listo']));
    }
    match /participantes/{id} {
      allow read: if admin() || own(id);
      allow write: if admin();
      match /registros/{registro} {
        allow read: if admin() || own(id);
        allow write: if admin();
      }
    }
    match /actividades/{id} {
      allow read: if admin() || active();
      allow write: if admin();
    }
  }
}
