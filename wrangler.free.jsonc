{
  "name": "jovenes-unen-al-barrio",
  "main": "standalone/worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {"directory": "./dist-free/client", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"]},
  "d1_databases": [{"binding":"DB","database_name":"jovenes-barrio","database_id":"00000000-0000-4000-8000-000000000000","migrations_dir":"drizzle"}],
  "vars": {"MEDIA_STORAGE":"d1"},
  "observability": {"enabled":false}
}
